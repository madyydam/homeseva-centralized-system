# ==============================================================================
# HOMESEVA ENTERPRISE ERP v1.6 - VPS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=homeseva
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=homeseva_db
DATABASE_URL=postgresql://homeseva:your_secure_postgres_password_here@postgres:5432/homeseva_db
DIRECT_URL=postgresql://homeseva:your_secure_postgres_password_here@postgres:5432/homeseva_db

# ─── Supabase Cloud (Optional / Hybrid Integration) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pxkopnkocescmtqcokda.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Auth & Security ───────────────────────────────────────────────────────────
AUTH_SECRET=your_super_secure_random_64_char_auth_secret_key_here
JWT_SECRET=your_super_secure_random_64_char_jwt_secret_key_here
AUTH_COOKIE_NAME=homeseva_user_session
AUTH_SESSION_MAX_AGE_SECONDS=604800

# ─── App URLs & Ports ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://erphomeseva.vercel.app
NODE_ENV=production
PORT=3000

# ─── Super Admin Bootstrap Credentials ────────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@homeseva.internal
SUPER_ADMIN_TEMP_PASSWORD=ChangeMe@123

# ─── Automated SMTP Email Delivery ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="HomeSeva ERP <no-reply@homeseva.internal>"
