# ==============================================================================
# HOMESEVA ENTERPRISE VPS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database Credentials
POSTGRES_USER=homeseva
POSTGRES_PASSWORD=replace_with_strong_production_password
POSTGRES_DB=homeseva_db

# Connection String for Application
DATABASE_URL=postgresql://homeseva:replace_with_strong_production_password@postgres:5432/homeseva_db

# Auth & Security
JWT_SECRET=replace_with_a_random_32_character_secret_key
SUPER_ADMIN_TEMP_PASSWORD=ChangeMeOnFirstLogin@2026

# Public App URL (e.g. https://portal.gentlehairwigs.com)
NEXT_PUBLIC_APP_URL=https://your-domain.com

