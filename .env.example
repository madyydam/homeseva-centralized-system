# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://homeseva:homeseva_pass@localhost:5432/homeseva_db"

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-random-64-char-string"
AUTH_COOKIE_NAME="homeseva_session"
AUTH_SESSION_MAX_AGE_SECONDS=28800

# ─── File Storage (MinIO / S3) ──────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="homeseva-files"
S3_REGION="ap-south-1"

# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NODE_ENV="development"

# ─── Super Admin (first-run bootstrap only) ─────────────────────────────
SUPER_ADMIN_EMAIL="superadmin@homeseva.internal"
SUPER_ADMIN_TEMP_PASSWORD="ChangeMe@123"
