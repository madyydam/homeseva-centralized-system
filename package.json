{
  "name": "homeseva",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "postinstall": "pnpm --filter @homeseva/db generate",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @homeseva/db migrate:dev",
    "db:studio": "pnpm --filter @homeseva/db studio",
    "db:generate": "pnpm --filter @homeseva/db generate",
    "db:seed": "pnpm --filter @homeseva/db seed",
    "desktop:dev": "pnpm --filter @homeseva/desktop dev",
    "desktop:pack": "pnpm --filter @homeseva/desktop pack",
    "desktop:dist": "pnpm --filter @homeseva/desktop dist"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
