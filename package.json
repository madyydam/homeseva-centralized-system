{
  "name": "homeseva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "postinstall": "pnpm --filter @homeseva/db generate",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @homeseva/db migrate:dev",
    "db:studio": "pnpm --filter @homeseva/db studio",
    "db:generate": "pnpm --filter @homeseva/db generate",
    "db:seed": "pnpm --filter @homeseva/db seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
