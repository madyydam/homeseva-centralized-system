# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (pooler for app, direct for migrations)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-random-64-char-string"
AUTH_COOKIE_NAME="homeseva_session"
AUTH_SESSION_MAX_AGE_SECONDS=28800

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-vercel-url.vercel.app"
NODE_ENV="production"

# ─── Super Admin (first-run bootstrap only) ───────────────────────────────────
SUPER_ADMIN_EMAIL="superadmin@homeseva.internal"
SUPER_ADMIN_TEMP_PASSWORD="ChangeMe@123"

